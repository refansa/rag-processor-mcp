{
  "name": "rag-processor-mcp",
  "version": "0.1.0",
  "description": "MCP server for semantic search over code repositories — conventions, utilities, project structures",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "inspect": "mcp-inspector -- node dist/index.js",
    "inspect:cli": "mcp-inspector --cli -- node dist/index.js",
    "inspect:standalone": "mcp-inspector",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "dependencies": {
    "@langchain/cohere": "^1.0.5",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "minisearch": "^7.2.0",
    "pg": "^8.21.0",
    "simple-git": "^3.27.0",
    "tree-sitter": "^0.25.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "tree-sitter-vue": "^0.2.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "protobufjs": "^7.2.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  }
}
